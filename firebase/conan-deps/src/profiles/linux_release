[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version=21
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=RelWithDebInfo

[buildenv]
CC=clang-21
CXX=clang++-21
CXXFLAGS=-fuse-ld=lld -Wl,--no-eh-frame-hdr -Wno-unused-command-line-argument
CFLAGS=-fuse-ld=lld -Wl,--no-eh-frame-hdr -Wno-unused-command-line-argument

[options]
protobuf/*:shared=False
aws-sdk-cpp/*:shared=False
zstd/*:shared=False
sentry/*:transport=curl
sentry/*:shared=False

[conf]
tools.gnu:pkg_config=/usr/bin/pkg-config

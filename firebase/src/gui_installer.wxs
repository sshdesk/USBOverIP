<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="USBIP &amp; Drivers" Language="1033" Version="1.0.1.0" Manufacturer="stim.io" UpgradeCode="7163fc54-0b12-4f90-afed-8f8cfb01690a" InstallerVersion="500" Scope="perMachine">

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." AllowSameVersionUpgrades="yes" />

        <MediaTemplate EmbedCab="yes" />

        <!-- 1. Directory Structure (Forced to 64-bit Program Files) -->
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="USBIP">
                <Directory Id="AppFolder" Name="bin" />
                <Directory Id="ScriptsFolder" Name="scripts">
                    <Directory Id="DriverFilesDir" Name="usbip_drivers" />
                </Directory>
            </Directory>
        </StandardDirectory>

        <!-- Start Menu & Desktop Directories -->
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="USBIP Suite" />
        </StandardDirectory>
        <StandardDirectory Id="DesktopFolder" />

        <DirectoryRef Id="AppFolder">
            <Component Id="GuiAppBinaryComponent" Guid="cc9a3725-1bc3-4f1e-be8d-4c5bfa02809f">
                <File Id="GuiUsbipExe" Source="bin\gui_usbip.exe" KeyPath="yes">
                    <!-- Start Menu Shortcut -->
                    <Shortcut Id="ApplicationStartMenuShortcut" 
                              Directory="ApplicationProgramsFolder" 
                              Name="USBIP GUI" 
                              WorkingDirectory="AppFolder" 
                              Advertise="yes" />
                    <!-- Desktop Shortcut -->
                    <Shortcut Id="ApplicationDesktopShortcut" 
                              Directory="DesktopFolder" 
                              Name="USBIP GUI" 
                              WorkingDirectory="AppFolder" 
                              Advertise="yes" />
                </File>
                <File Id="GoogleServicesJsonGui" Source="bin\google-services.json" />
                <File Id="DevNodeExeGui" Source="bin\devnode.exe" />
                <File Id="ConfExe" Source="script\config.txt" />
            </Component>
            <Directory Id="AssetsFolder" Name="assets">
                <Component Id="GuiAssetsComponent" Guid="8f4b2a1c-3e5d-4f7a-9b1c-2d3e4f5a6b7c">
                    <File Id="ArialTtf" Source="bin\assets\arial.ttf" KeyPath="yes" />
                </Component>
            </Directory>
        </DirectoryRef>

        <!-- Start Menu Folder Component -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationProgramsFolderComponent" Guid="1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d">
                <RemoveFolder Id="CleanUpShortcuts" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\Microsoft\USBIPGui" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>


        <DirectoryRef Id="DriverFilesDir">
            <Component Id="GuiScriptsComponent" Guid="d4d54c09-9f1c-439f-a7a5-8d20bb29eb5e">
                <!-- PowerShell Scripts -->
                <File Id="UsbipInstallScriptGui" Source="usbip\drivers\install_usbip_drivers.ps1" KeyPath="yes" />
                <File Id="UsbipUninstallScriptGui" Source="usbip\drivers\uninstall_usbip_drivers.ps1" />
                
                <!-- Helper Executable -->
                <File Id="DevNodeExeDrivers" Source="usbip\drivers\devnode.exe" />

                <!-- USBIP UDE Driver Files -->
                <File Id="Usbip2UdeSys" Source="usbip\drivers\usbip2_ude.sys" />
                <File Id="Usbip2UdeInf" Source="usbip\drivers\usbip2_ude.inf" />
                <File Id="Usbip2UdeCat" Source="usbip\drivers\usbip2_ude.cat" />

                <!-- USBIP Filter Driver Files -->
                <File Id="Usbip2FilterSys" Source="usbip\drivers\usbip2_filter.sys" />
                <File Id="Usbip2FilterInf" Source="usbip\drivers\usbip2_filter.inf" />
                <File Id="Usbip2FilterCat" Source="usbip\drivers\usbip2_filter.cat" />

                <!-- VBox Drivers -->
                <File Id="UsbipdInstallScriptGui" Source="usbipd\drivers\install_usbipd_drivers.ps1" />
                <File Id="UsbipdUninstallScriptGui" Source="usbipd\drivers\uninstall_usbipd_drivers.ps1" />
                <File Id="VBoxUSBInfGui" Source="usbipd\drivers\VBoxUSB.inf" />
                <File Id="VBoxUSBCatGui" Source="usbipd\drivers\VBoxUSB.cat" />
                <File Id="VBoxUSBSysGui" Source="usbipd\drivers\VBoxUSB.sys" />
                <File Id="VBoxUSBMonSysGui" Source="usbipd\drivers\VBoxUSBMon.sys" />
                <File Id="VBoxUsbPnfGui" Source="usbipd\drivers\vboxusb.PNF" />
            </Component>
        </DirectoryRef>


        <Feature Id="ProductFeature" Title="USBIP Suite" Level="1">
            <ComponentRef Id="GuiAppBinaryComponent" />
            <ComponentRef Id="GuiAssetsComponent" />
            <ComponentRef Id="GuiScriptsComponent" />
            <ComponentRef Id="ApplicationProgramsFolderComponent" />
        </Feature>


        <!-- USBIP Drivers Custom Actions -->
        <CustomAction Id="RunInstallUsbipGui" 
                      Directory="DriverFilesDir" 
                      ExeCommand="powershell.exe -NoLogo -ExecutionPolicy Bypass -NoProfile -Command &quot;cd '[DriverFilesDir]'; &amp; '[DriverFilesDir]\install_usbip_drivers.ps1'; if (-not $?) { Read-Host 'USBIP Driver installation failed. Press Enter to exit' }&quot;" 
                      Execute="deferred" Return="check" Impersonate="no" />

        <CustomAction Id="RunUninstallUsbipGui" 
                      Directory="DriverFilesDir" 
                      ExeCommand="powershell.exe -NoLogo -ExecutionPolicy Bypass -NoProfile -Command &quot;cd '[DriverFilesDir]'; &amp; '[DriverFilesDir]\uninstall_usbip_drivers.ps1'; if (-not $?) { Read-Host 'USBIP Driver uninstallation failed. Press Enter to exit' }&quot;" 
                      Execute="deferred" Return="ignore" Impersonate="no" />

        <!-- USBIPD (VBox) Drivers Custom Actions -->
        <CustomAction Id="RunInstallUsbipdGui" 
                      Directory="DriverFilesDir" 
                      ExeCommand="powershell.exe -NoLogo -ExecutionPolicy Bypass -NoProfile -Command &quot;cd '[DriverFilesDir]'; &amp; '[DriverFilesDir]\install_usbipd_drivers.ps1'; if (-not $?) { Read-Host 'USBIPD Driver installation failed. Press Enter to exit' }&quot;" 
                      Execute="deferred" Return="check" Impersonate="no" />

        <CustomAction Id="RunUninstallUsbipdGui" 
                      Directory="DriverFilesDir" 
                      ExeCommand="powershell.exe -NoLogo -ExecutionPolicy Bypass -NoProfile -Command &quot;cd '[DriverFilesDir]'; &amp; '[DriverFilesDir]\uninstall_usbipd_drivers.ps1'; if (-not $?) { Read-Host 'USBIPD Driver uninstallation failed. Press Enter to exit' }&quot;" 
                      Execute="deferred" Return="ignore" Impersonate="no" />

        <InstallExecuteSequence>
            <!-- Installation Sequence -->
            <Custom Action="RunInstallUsbipGui" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
            <Custom Action="RunInstallUsbipdGui" After="RunInstallUsbipGui" Condition="NOT Installed OR REINSTALL" />

            <!-- Uninstallation Sequence -->
            <Custom Action="RunUninstallUsbipGui" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot; AND NOT WIX_UPGRADE_DETECTED" />
            <Custom Action="RunUninstallUsbipdGui" Before="RunUninstallUsbipGui" Condition="REMOVE = &quot;ALL&quot; AND NOT WIX_UPGRADE_DETECTED" />
        </InstallExecuteSequence>
    </Package>
</Wix>
